generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Role {
  USER
  SELLER
  ADMIN
}


// ========================= Listing - publicacion
enum ListingOperation {
  SALE
  RENT
}

enum RentPeriod {
  DAY
  WEEK
  MONTH
}

enum MachineCondition {
  NEW
  USED
}

enum Currency {
  USD
  UYU
  ARS
  BRL
  PYG
}

enum ListingStatus {
  DRAFT       // Borrador: todavía no está publicada
  PUBLISHED   // Publicada y visible en el marketplace
  PAUSED      // Pausada temporalmente por el vendedor
  SOLD        // Vendida
  RENTED      // Alquilada
  EXPIRED     // Vencida
}

model Listing {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  operation     ListingOperation
  rentPeriod    RentPeriod?
  condition     MachineCondition
  currency      Currency         @default(USD)
  price         Decimal          @db.Decimal(12, 2)
  machineType   String
  year          Int
  hours         Int?
  horsepower    Int?
  location      String
  country       String?
  description   String
  featuredUntil DateTime?       //cuando vence el destacado, asi lo vamos a usar const isFeatured = listing.featuredUntil != null && listing.featuredUntil > new Date()
  
  status        ListingStatus   @default(DRAFT)

  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([machineType, featuredUntil])
  @@index([operation, machineType])
  @@index([sellerId])
}
// =================================


// ===================== Suscripcion
enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

model Subscription {
  id String @id @default(uuid())

  sellerId String @unique
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?

  isComplimentary        Boolean   @default(false)
  externalSubscriptionId String?
  expiryNotifiedAt       DateTime?

  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
}
// =================================


// ======================== Plan
model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  price       Decimal  @db.Decimal(10, 2)
  currency    Currency @default(USD)
  maxListings Int
  maxFeatured Int      @default(0) //- Cantidad de publicaciones destacadas por vendedor
  features    String[]
  isActive    Boolean  @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// =================================


model User {
  id String @id @default(uuid())

  fullName String?
  email    String  @unique
  password String?

  role     Role    @default(USER)
  isActive Boolean @default(true)

  sessions Session[]
  seller   Seller?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash     String    @unique
  prevTokenHash String?   @unique
  rotatedAt     DateTime?

  userAgent String?
  ipAddress String?

  isActive  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, isActive])
  @@index([expiresAt])
}

model Seller {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  slug        String     @unique
  avatarUrl   String?
  about       String?    @db.Text

  phone    String
  whatsapp String?

  website  String?

  country  String // código ISO: "UY", "AR", "PE"
  location String

  subscription Subscription?
  listings Listing[]

  deletedAt DateTime? 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
  @@index([deletedAt])
}

